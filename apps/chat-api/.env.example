# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (chat-api-postgres container on port 5434)
DATABASE_URL=postgresql://chat:chat_dev_password@localhost:5434/chat

# Redis (chat-api-redis container on port 6381)
REDIS_URL=redis://localhost:6381

# Auth (Privy)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# API Secret (min 32 chars, shared with main API for internal calls)
CHAT_API_SECRET=chat_api_secret_for_local_development_only
