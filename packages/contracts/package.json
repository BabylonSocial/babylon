{
  "name": "@babylon/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart contract types and deployment information for Babylon",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./deployments/local": {
      "types": "./deployments/local/index.ts",
      "import": "./deployments/local/index.ts",
      "require": "./deployments/local/index.ts"
    },
    "./deployments/base-sepolia": {
      "types": "./deployments/base-sepolia/index.ts",
      "import": "./deployments/base-sepolia/index.ts",
      "require": "./deployments/base-sepolia/index.ts"
    },
    "./deployments/base": {
      "types": "./deployments/base/index.ts",
      "import": "./deployments/base/index.ts",
      "require": "./deployments/base/index.ts"
    }
  },
  "files": [
    "src",
    "deployments"
  ],
  "scripts": {
    "lint": "biome lint src/",
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@babylon/shared": "workspace:*"
  },
  "peerDependencies": {
    "ethers": "^6.16.0",
    "viem": "^2.41.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "hardhat-preprocessor": "^0.1.5",
    "typescript": "^5.9.3"
  }
}
